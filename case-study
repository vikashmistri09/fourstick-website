
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Case Studies | FOURSTICK</title>
  <meta name="description" content="Explore performance marketing and B2B lead generation case studies from FOURSTICK. Discover campaign strategies, challenges and business outcomes.">

  <style>
    :root {
      --bg: #ffffff;
      --surface: #f7f7f7;
      --text: #171717;
      --muted: #696969;
      --border: #e5e5e5;
      --black: #111111;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.6;
    }

    body.modal-open {
      overflow: hidden;
    }

    button {
      font: inherit;
    }

    button:focus-visible,
    a:focus-visible {
      outline: 3px solid #777;
      outline-offset: 4px;
    }

    .container {
      width: min(1160px, 90%);
      margin: auto;
    }

    /* HERO */

    .hero {
      padding: 85px 0 55px;
      border-bottom: 1px solid var(--border);
    }

    .eyebrow {
      font-size: 12px;
      letter-spacing: 2px;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--muted);
    }

    .hero h1 {
      max-width: 800px;
      font-size: clamp(36px, 5.5vw, 64px);
      line-height: 1.08;
      letter-spacing: -2px;
      margin: 18px 0;
    }

    .hero p {
      max-width: 650px;
      color: var(--muted);
      font-size: 17px;
      margin: 0;
    }

    /* CASE STUDY GRID */

    .case-section {
      padding: 55px 0 90px;
    }

    .section-heading {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 20px;
      margin-bottom: 30px;
    }

    .section-heading h2 {
      font-size: 28px;
      margin: 0;
      letter-spacing: -0.7px;
    }

    #caseCount {
      color: var(--muted);
      font-size: 14px;
    }

    .case-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }

    .case-card {
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      background: #fff;
      display: flex;
      flex-direction: column;
      min-width: 0;
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .case-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 30px rgba(0,0,0,.06);
    }

    .case-image {
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      display: block;
      background: #eeeeee;
    }

    .image-placeholder {
      aspect-ratio: 16 / 9;
      display: grid;
      place-items: center;
      background: #eeeeee;
      color: #777;
      font-size: 13px;
    }

    .case-content {
      padding: 24px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      flex: 1;
    }

    .case-industry {
      color: var(--muted);
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.2px;
    }

    .case-content h3 {
      font-size: 22px;
      line-height: 1.3;
      letter-spacing: -.4px;
      margin: 12px 0;
    }

    .case-summary {
      font-size: 14px;
      color: var(--muted);
      margin: 0 0 20px;
    }

    .case-services {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      margin-bottom: 24px;
    }

    .service-tag {
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 5px 9px;
      font-size: 11px;
      color: #444;
    }

    .view-btn {
      margin-top: auto;
      width: 100%;
      padding: 12px 16px;
      border: 1px solid var(--black);
      border-radius: 5px;
      background: var(--black);
      color: white;
      cursor: pointer;
      font-weight: 600;
      font-size: 13px;
      transition: background .2s, color .2s;
    }

    .view-btn:hover {
      background: white;
      color: var(--black);
    }

    .empty-state {
      grid-column: 1 / -1;
      padding: 50px 20px;
      text-align: center;
      color: var(--muted);
      background: var(--surface);
      border-radius: 10px;
    }

    /* POPUP / MODAL */

    .modal {
      position: fixed;
      inset: 0;
      z-index: 9999;
      padding: 24px;
      display: none;
      align-items: center;
      justify-content: center;
      background: rgba(0, 0, 0, .72);
    }

    .modal.is-open {
      display: flex;
    }

    .modal-panel {
      position: relative;
      width: min(760px, 100%);
      max-height: 88vh;
      overflow-y: auto;
      overscroll-behavior: contain;
      background: #fff;
      border-radius: 12px;
      padding: clamp(24px, 5vw, 48px);
      animation: modalIn .2s ease;
    }

    @keyframes modalIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .modal-close {
      position: absolute;
      top: 15px;
      right: 15px;
      width: 40px;
      height: 40px;
      border: 1px solid var(--border);
      border-radius: 50%;
      background: #fff;
      font-size: 24px;
      line-height: 1;
      cursor: pointer;
    }

    .modal-close:hover {
      background: var(--surface);
    }

    .modal-panel h2 {
      font-size: clamp(27px, 4vw, 40px);
      line-height: 1.2;
      letter-spacing: -1px;
      padding-right: 25px;
      margin: 12px 0;
    }

    .modal-summary {
      color: var(--muted);
      margin-bottom: 28px;
    }

    .modal-image {
      width: 100%;
      max-height: 320px;
      object-fit: cover;
      border-radius: 8px;
      margin-bottom: 25px;
    }

    .result-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      margin: 25px 0 32px;
    }

    .result-box {
      padding: 17px 12px;
      background: var(--surface);
      border-radius: 7px;
    }

    .result-value {
      font-size: 21px;
      font-weight: 700;
      display: block;
      overflow-wrap: anywhere;
    }

    .result-label {
      font-size: 12px;
      color: var(--muted);
      display: block;
      margin-top: 5px;
    }

    .detail-block {
      margin: 28px 0;
    }

    .detail-block h3 {
      font-size: 18px;
      margin: 0 0 8px;
    }

    .detail-block p {
      color: #555;
      margin: 0;
      white-space: pre-line;
    }

    .modal-cta {
      display: inline-block;
      margin-top: 15px;
      padding: 13px 22px;
      background: var(--black);
      color: white;
      text-decoration: none;
      border-radius: 5px;
      font-size: 14px;
      font-weight: 600;
    }

    .modal-cta:hover {
      opacity: .8;
    }

    @media (max-width: 900px) {
      .case-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 600px) {
      .hero {
        padding: 55px 0 40px;
      }

      .hero h1 {
        letter-spacing: -1px;
      }

      .case-section {
        padding: 38px 0 60px;
      }

      .case-grid {
        grid-template-columns: 1fr;
        gap: 18px;
      }

      .case-content {
        padding: 20px;
      }

      .section-heading {
        align-items: flex-start;
        flex-direction: column;
        gap: 6px;
      }

      .modal {
        padding: 10px;
      }

      .modal-panel {
        max-height: 94vh;
        border-radius: 9px;
        padding: 28px 20px;
      }

      .modal-close {
        top: 10px;
        right: 10px;
      }

      .result-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: .01ms !important;
        transition-duration: .01ms !important;
      }
    }
  </style>
</head>

<body>

  <header class="hero">
    <div class="container">
      <div class="eyebrow">FOURSTICK / OUR WORK</div>
      <h1>Real Campaigns. Clear Strategy. Measurable Growth.</h1>
      <p>
        Explore how strategic performance marketing, paid advertising
        and conversion optimization help businesses work toward
        measurable growth.
      </p>
    </div>
  </header>

  <main>
    <section class="case-section">
      <div class="container">

        <div class="section-heading">
          <h2>Selected Case Studies</h2>
          <span id="caseCount" aria-live="polite"></span>
        </div>

        <div class="case-grid" id="caseGrid"></div>

      </div>
    </section>
  </main>

  <!-- Case Study Popup -->
  <div
    class="modal"
    id="caseModal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modalTitle"
    aria-hidden="true"
  >
    <div class="modal-panel" id="modalPanel">
      <button
        class="modal-close"
        id="modalClose"
        type="button"
        aria-label="Close case study"
      >&times;</button>

      <div id="modalContent"></div>
    </div>
  </div>

  <script>
    /*
      ADD YOUR CASE STUDIES HERE.

      Duplicate any object below and change its details.
      Use real, verified client results only.
      Keep image empty ("") if you do not have an image.
    */

    const caseStudies = [
      {
        id: 1,
        industry: "B2B Lead Generation",
        title: "B2B Lead Generation Campaign",
        summary: "A campaign focused on attracting relevant business enquiries and improving lead quality.",
        services: ["Google Ads", "Lead Generation", "Tracking"],
        image: "",

        metrics: [
          { value: "Add result", label: "Qualified Leads" },
          { value: "Add result", label: "Cost Per Lead" },
          { value: "Add result", label: "Conversion Rate" }
        ],

        challenge: "Describe the client's business challenge, target audience and the problem the campaign needed to solve.",

        strategy: "Explain the campaign strategy, keyword research, audience targeting, landing page improvements and conversion tracking.",

        execution: "Explain what you personally managed, the campaign structure, optimization process and how lead quality was evaluated.",

        results: "Add verified campaign results here. Explain the measurement period and what changed compared with the previous baseline.",

        duration: "Add campaign duration"
      },

      {
        id: 2,
        industry: "E-commerce",
        title: "E-commerce Customer Acquisition",
        summary: "A performance marketing campaign focused on customer acquisition and advertising efficiency.",
        services: ["Meta Ads", "Google Ads", "Optimization"],
        image: "",

        metrics: [
          { value: "Add result", label: "Revenue" },
          { value: "Add result", label: "ROAS" },
          { value: "Add result", label: "Cost Per Purchase" }
        ],

        challenge: "Describe the e-commerce brand's acquisition challenge, product category and business goals.",

        strategy: "Explain the targeting, campaign structure, creative testing and budget allocation strategy.",

        execution: "Describe the campaign management, testing and optimization work that was actually performed.",

        results: "Add verified revenue, ROAS or acquisition results, including the reporting period and relevant context.",

        duration: "Add campaign duration"
      }
    ];

    const grid = document.getElementById("caseGrid");
    const count = document.getElementById("caseCount");
    const modal = document.getElementById("caseModal");
    const modalContent = document.getElementById("modalContent");
    const modalClose = document.getElementById("modalClose");
    const modalPanel = document.getElementById("modalPanel");

    let lastFocusedElement = null;

    // Safely escape text before inserting it into HTML.
    function escapeHTML(value) {
      return String(value ?? "").replace(/[&<>"']/g, char => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
      })[char]);
    }

    function safeImageURL(value) {
      try {
        const url = new URL(value, window.location.href);

        if (
          url.protocol === "https:" ||
          url.protocol === "http:"
        ) {
          return url.href;
        }
      } catch (error) {}

      return "";
    }

    function renderCaseStudies() {
      count.textContent = `${caseStudies.length} case studies`;

      if (caseStudies.length === 0) {
        grid.innerHTML = `
          <div class="empty-state">
            Case studies will be added soon.
          </div>
        `;
        return;
      }

      grid.innerHTML = caseStudies.map(item => {
        const imageURL = safeImageURL(item.image);

        const imageHTML = imageURL
          ? `<img class="case-image"
                  src="${escapeHTML(imageURL)}"
                  alt="${escapeHTML(item.title)}"
                  loading="lazy">`
          : `<div class="image-placeholder">FOURSTICK / CASE STUDY</div>`;

        const tagsHTML = (item.services || [])
          .map(service =>
            `<span class="service-tag">${escapeHTML(service)}</span>`
          )
          .join("");

        return `
          <article class="case-card">
            ${imageHTML}

            <div class="case-content">
              <span class="case-industry">
                ${escapeHTML(item.industry)}
              </span>

              <h3>${escapeHTML(item.title)}</h3>

              <p class="case-summary">
                ${escapeHTML(item.summary)}
              </p>

              <div class="case-services">
                ${tagsHTML}
              </div>

              <button
                class="view-btn"
                type="button"
                data-case-id="${escapeHTML(item.id)}"
                aria-haspopup="dialog"
              >
                View Case Study →
              </button>
            </div>
          </article>
        `;
      }).join("");
    }

    function openCaseStudy(id, trigger) {
      const item = caseStudies.find(
        study => String(study.id) === String(id)
      );

      if (!item) return;

      lastFocusedElement = trigger;

      const imageURL = safeImageURL(item.image);

      const imageHTML = imageURL
        ? `<img class="modal-image"
                src="${escapeHTML(imageURL)}"
                alt="${escapeHTML(item.title)}">`
        : "";

      const metricsHTML = (item.metrics || [])
        .map(metric => `
          <div class="result-box">
            <span class="result-value">
              ${escapeHTML(metric.value)}
            </span>
            <span class="result-label">
              ${escapeHTML(metric.label)}
            </span>
          </div>
        `)
        .join("");

      modalContent.innerHTML = `
        <div class="eyebrow">
          ${escapeHTML(item.industry)}
        </div>

        <h2 id="modalTitle">
          ${escapeHTML(item.title)}
        </h2>

        <p class="modal-summary">
          ${escapeHTML(item.summary)}
        </p>

        ${imageHTML}

        <div class="result-grid">
          ${metricsHTML}
        </div>

        <div class="detail-block">
          <h3>The Challenge</h3>
          <p>${escapeHTML(item.challenge)}</p>
        </div>

        <div class="detail-block">
          <h3>The Strategy</h3>
          <p>${escapeHTML(item.strategy)}</p>
        </div>

        <div class="detail-block">
          <h3>Execution</h3>
          <p>${escapeHTML(item.execution)}</p>
        </div>

        <div class="detail-block">
          <h3>Results & Learnings</h3>
          <p>${escapeHTML(item.results)}</p>
        </div>

        <div class="detail-block">
          <h3>Campaign Duration</h3>
          <p>${escapeHTML(item.duration)}</p>
        </div>

        <a class="modal-cta" href="/contact/">
          Discuss Your Project →
        </a>
      `;

      modal.classList.add("is-open");
      modal.setAttribute("aria-hidden", "false");
      document.body.classList.add("modal-open");

      modalPanel.scrollTop = 0;
      modalClose.focus();
    }

    function closeCaseStudy() {
      modal.classList.remove("is-open");
      modal.setAttribute("aria-hidden", "true");
      document.body.classList.remove("modal-open");

      if (lastFocusedElement) {
        lastFocusedElement.focus();
      }
    }

    // Event delegation: works for every generated card.
    grid.addEventListener("click", event => {
      const button = event.target.closest("[data-case-id]");

      if (!button) return;

      openCaseStudy(button.dataset.caseId, button);
    });

    modalClose.addEventListener("click", closeCaseStudy);

    // Close when clicking the dark overlay.
    modal.addEventListener("click", event => {
      if (event.target === modal) {
        closeCaseStudy();
      }
    });

    // Close on Escape.
    document.addEventListener("keydown", event => {
      if (
        event.key === "Escape" &&
        modal.classList.contains("is-open")
      ) {
        closeCaseStudy();
      }
    });

    renderCaseStudies();
  </script>

</body>
</html>
